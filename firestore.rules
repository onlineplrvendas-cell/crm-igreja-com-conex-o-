rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSystemAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserDoc().role == 'admin' &&
         getUserDoc().active == true) ||
        request.auth.token.email == 'onlineplrvendas@gmail.com'
      );
    }

    function isStaffMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc().active == true;
    }

    function canAccessCongregation(congregationName) {
      return isSystemAdmin() || (
        isStaffMember() &&
        (congregationName in getUserDoc().assignedCongregations ||
         getUserDoc().assignedCongregations.matches('.*' + congregationName + '.*'))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      // Users can read their own profile, Admins can read all profiles
      allow get: if isSignedIn() && (request.auth.uid == userId || isSystemAdmin());
      allow list: if isSignedIn() && isStaffMember();

      // Only admins can create/update staff roles and congregation assignments
      allow create: if isSystemAdmin() || (isSignedIn() && request.auth.uid == userId && !('role' in request.resource.data && request.resource.data.role == 'admin'));
      allow update: if isSystemAdmin() || (isSignedIn() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'assignedCongregations', 'active']));
      allow delete: if isSystemAdmin();
    }

    // Contacts Collection
    match /contacts/{contactId} {
      allow get: if isSignedIn() && isStaffMember() && canAccessCongregation(resource.data.congregation);
      allow list: if isSignedIn() && isStaffMember();

      allow create: if isSignedIn() && isStaffMember() &&
        canAccessCongregation(request.resource.data.congregation) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.phone is string && request.resource.data.phone.size() > 0 &&
        request.resource.data.congregation in ['Recreio', 'Curicica', 'Guaratiba'] &&
        request.resource.data.category in ['Novo contato', 'Visitante', 'Membro'] &&
        request.resource.data.stage in ['Aguardando primeiro contato', '1º contato feito', 'Em acompanhamento', 'Integrado', 'Acompanhamento pausado'];

      allow update: if isSignedIn() && isStaffMember() &&
        canAccessCongregation(resource.data.congregation) &&
        (isSystemAdmin() || request.resource.data.congregation == resource.data.congregation);

      allow delete: if isSystemAdmin();
    }

    // Interactions Collection
    match /interactions/{interactionId} {
      allow get: if isSignedIn() && isStaffMember() && canAccessCongregation(resource.data.congregation);
      allow list: if isSignedIn() && isStaffMember();

      allow create: if isSignedIn() && isStaffMember() &&
        canAccessCongregation(request.resource.data.congregation) &&
        request.resource.data.contactId is string &&
        request.resource.data.channel in ['WhatsApp', 'Ligação', 'Presencial', 'Outro'];

      allow update: if isSignedIn() && isStaffMember() &&
        canAccessCongregation(resource.data.congregation);

      allow delete: if isSystemAdmin();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow get: if isSignedIn() && isStaffMember() && canAccessCongregation(resource.data.congregation);
      allow list: if isSignedIn() && isStaffMember();

      allow create: if isSignedIn() && isStaffMember() &&
        canAccessCongregation(request.resource.data.congregation) &&
        request.resource.data.contactId is string &&
        request.resource.data.description is string &&
        request.resource.data.dueDate is string &&
        request.resource.data.status in ['pending', 'completed'];

      allow update: if isSignedIn() && isStaffMember() &&
        canAccessCongregation(resource.data.congregation);

      allow delete: if isSystemAdmin();
    }

    // Weekly Confirmations Collection
    match /weekly_confirmations/{reportId} {
      allow get, list: if isSignedIn() && isStaffMember();
      allow create, update: if isSignedIn() && isStaffMember();
      allow delete: if isSystemAdmin();
    }
  }
}

